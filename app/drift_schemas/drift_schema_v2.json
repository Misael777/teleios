  "fixed_sql": [
    {
      "name": "dimensions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dimensions\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"color_hex\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "emotions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"emotions\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES emotions (id), \"is_system\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_system\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "triggers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"triggers\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"is_system\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_system\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "topics",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"topics\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL, \"dimension_id\" TEXT NOT NULL REFERENCES dimensions (id), \"status\" TEXT NOT NULL, \"origin\" TEXT NOT NULL, \"confidence\" REAL NULL, \"note\" TEXT NULL, \"validation_passage\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"name_key\", \"dimension_id\"));"
        }
      ]
    },
    {
      "name": "devotionals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devotionals\" (\"id\" TEXT NOT NULL, \"date\" INTEGER NOT NULL, \"book_code\" TEXT NOT NULL, \"chapter\" INTEGER NOT NULL, \"verse_start\" INTEGER NULL, \"verse_end\" INTEGER NULL, \"content\" TEXT NOT NULL, \"period_id\" TEXT NULL, \"empire_id\" TEXT NULL, \"region_id\" TEXT NULL, \"author\" TEXT NULL, \"approx_year\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "devotional_topics",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devotional_topics\" (\"devotional_id\" TEXT NOT NULL REFERENCES devotionals (id) ON DELETE CASCADE, \"topic_id\" TEXT NOT NULL REFERENCES topics (id) ON DELETE CASCADE, \"origin\" TEXT NOT NULL, PRIMARY KEY (\"devotional_id\", \"topic_id\"));"
        }
      ]
    },
    {
      "name": "praxis_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"praxis_entries\" (\"id\" TEXT NOT NULL, \"date\" INTEGER NOT NULL, \"circumstance\" TEXT NOT NULL, \"intensity\" INTEGER NOT NULL CHECK(\"intensity\" BETWEEN 1 AND 10), \"filter\" TEXT NOT NULL, \"foundation_detail\" TEXT NULL, \"passage\" TEXT NULL, \"action\" TEXT NOT NULL, \"peace\" INTEGER NOT NULL CHECK(\"peace\" BETWEEN 1 AND 10), \"coherence\" INTEGER NULL CHECK(\"coherence\" BETWEEN 1 AND 10), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "praxis_emotions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"praxis_emotions\" (\"praxis_id\" TEXT NOT NULL REFERENCES praxis_entries (id) ON DELETE CASCADE, \"emotion_id\" TEXT NOT NULL REFERENCES emotions (id), PRIMARY KEY (\"praxis_id\", \"emotion_id\"));"
        }
      ]
    },
    {
      "name": "praxis_triggers",
      "sql": [
        {
